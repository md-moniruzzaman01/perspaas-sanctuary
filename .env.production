# Production build values. Vite loads this automatically for `vite build`
# (it outranks .env, which holds local-development values), so a production
# bundle no longer depends on what happens to be exported in the shell that
# runs the build. Everything here is public — it ships inside the JS bundle —
# so no secret ever belongs in this file.

VITE_API_URL=https://api.perspaas.com
VITE_WHATSAPP_NUMBER=5491131081959

# PersPaaS ecosystem landing page — the target of the "Home" nav button.
# No trailing slash needed (one is stripped). Point this at the local
# ecosystem-landing dev server (e.g. http://localhost:5174) to test the hop
# between apps without leaving your machine.
VITE_LANDING_URL=https://perspaas.com
