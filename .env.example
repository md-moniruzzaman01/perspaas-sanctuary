# Local development values. Copy to .env and adjust.
#
# Production values live in .env.production (committed) — Vite loads that file
# for `vite build` and it overrides everything here, so a production build does
# not depend on whoever runs it remembering to change .env.

# Central-backend API base URL (no trailing slash).
# Production: https://api.perspaas.com
VITE_API_URL=http://localhost:4000

# WhatsApp business number for the prefilled conversation CTAs, digits only
# (country code included, no +, spaces or dashes). Supplied by the client
# before launch; shared across the PersPaaS ecosystem. Leave this set even
# locally — an empty value renders the CTAs as a dead https://wa.me/ link.
VITE_WHATSAPP_NUMBER=5491131081959

# PersPaaS ecosystem landing page — the target of the "Home" nav button.
# No trailing slash needed (one is stripped). Point this at the local
# ecosystem-landing dev server (e.g. http://localhost:5174) to test the hop
# between apps without leaving your machine.
VITE_LANDING_URL=https://perspaas.com
